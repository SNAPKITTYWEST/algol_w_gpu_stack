COMMENT Provenance: docs/NODE_MANIFEST.json;
COMMENT BLOCK 050 foundation self-test;
COMMENT BLOCK 050;
COMMENT Component: AwgFoundationTest;
COMMENT Purpose: AwgFoundationTest as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgFoundationTest;
COMMENT Parent-ID: AWG-FILE-001AwgFoundation;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgFoundationTest(INTEGER RESULT Status);
BEGIN
    INTEGER A, B, C, S;
    IF AwgInitialized # 1 THEN AwgRuntimeInit(S);
    A := AwgIAnd(12, 10);
    B := AwgIOr(12, 10);
    C := AwgIXor(12, 10);
    IF A # 8 THEN Status := StValidate
    ELSE IF B # 14 THEN Status := StValidate
    ELSE IF C # 6 THEN Status := StValidate
    ELSE IF AwgAlignUp(13, 8) # 16 THEN Status := StValidate
    ELSE IF AwgPopc(7) # 3 THEN Status := StValidate
    ELSE IF AwgIMin(3, 5) # 3 THEN Status := StValidate
    ELSE IF AwgComposeId(1, 7) # AwgPackBits(7, 16, 0, AwgIShl(1, 16)) THEN
        Status := StValidate
    ELSE
    BEGIN
        AwgInvariantCheck(Status);
        IF Status = StOk THEN AwgTestPass := AwgTestPass + 1
    END;
    IF Status # StOk THEN AwgTestFail := AwgTestFail + 1;
    AwgSetStatus(Status, 50, A)
END;
