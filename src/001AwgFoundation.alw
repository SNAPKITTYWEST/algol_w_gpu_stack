COMMENT BLOCK 027 state validation;
COMMENT BLOCK 027;
COMMENT Component: AwgStateValidate;
COMMENT Purpose: AwgStateValidate as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgStateValidate;
COMMENT Parent-ID: AWG-FILE-001AwgFoundation;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgStateValidate(INTEGER RESULT Status);
BEGIN
    IF AwgInitialized # 1 THEN
    BEGIN
        Status := StNotInit;
        AwgSetStatus(StNotInit, 27, 0)
    END
    ELSE IF AwgHostUsed < 0 THEN Status := StValidate
    ELSE IF AwgHostUsed > CapHost THEN Status := StValidate
    ELSE IF AwgDevUsed < 0 THEN Status := StValidate
    ELSE IF AwgDevUsed > CapDev THEN Status := StValidate
    ELSE IF AwgOpCount < 0 THEN Status := StValidate
    ELSE IF AwgOpCount > CapOps THEN Status := StValidate
    ELSE Status := StOk
END;

