COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgTakeOwner(INTEGER RESULT Status);
BEGIN
    IF AwgOwnerToken = 1 THEN
    BEGIN
        Status := StConflict;
        AwgSetStatus(StConflict, 49, 1)
    END
    ELSE
    BEGIN
        AwgOwnerToken := 1;
        Status := StOk
    END
END;

