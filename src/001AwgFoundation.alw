COMMENT Provenance: docs/NODE_MANIFEST.json;
INTEGER PROCEDURE AwgSizeOfKind(INTEGER VALUE Kind);
BEGIN
    IF Kind = KindInt THEN AwgSizeOfKind := 1
    ELSE IF Kind = KindReal THEN AwgSizeOfKind := 1
    ELSE IF Kind = KindLong THEN AwgSizeOfKind := 2
    ELSE IF Kind = KindLog THEN AwgSizeOfKind := 1
    ELSE IF Kind = KindBits THEN AwgSizeOfKind := 1
    ELSE AwgSizeOfKind := 0
END;

