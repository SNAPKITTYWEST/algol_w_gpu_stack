PROCEDURE AwgTracePush(INTEGER VALUE Op, Pc, Info, Stat);
BEGIN
    INTEGER S;
    IF AwgTraceCount < 256 THEN
    BEGIN
        AwgTrTab(AwgTraceCount) := AwgTrRec(AwgCycle, Op, Pc, Info, Stat);
        AwgTraceCount := AwgTraceCount + 1
    END
END;

COMMENT SOVEREIGN NODE KEY: AWG-FILE-001AwgFoundation-BLK-025-73;
COMMENT Parent-ID: AWG-FILE-001AwgFoundation;
