COMMENT BLOCK 046;
COMMENT Component: AwgPackBits / AwgUnpackBits;
COMMENT Purpose: portable integer bit field pack using powers of two;
COMMENT Hardware: none — not a GPU bit-field instruction;
COMMENT BLOCK 046;
COMMENT Component: AwgIAnd;
COMMENT Purpose: AwgIAnd as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgIAnd;
COMMENT Parent-ID: AWG-FILE-001AwgFoundation;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
INTEGER PROCEDURE AwgIAnd(INTEGER VALUE A, B);
BEGIN
    INTEGER R, P, X, Y;
    R := 0; P := 1;
    X := A; Y := B;
    IF X < 0 THEN X := 0;
    IF Y < 0 THEN Y := 0;
    WHILE (X > 0) OR (Y > 0) DO
    BEGIN
        IF ODD(X) AND ODD(Y) THEN R := R + P;
        X := X DIV 2;
        Y := Y DIV 2;
        IF P > (MaxInt DIV 2) THEN
        BEGIN
            X := 0; Y := 0
        END
        ELSE P := P * 2
    END;
    AwgIAnd := R
END;

COMMENT BLOCK 046;
COMMENT Component: AwgIOr;
COMMENT Purpose: AwgIOr as defined by the following supplied procedure;
