COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgZeroBuf(INTEGER VALUE Id);
BEGIN
    IF (Id >= 0) AND (Id <= 63) THEN
        AwgBufTab(Id) := AwgBufRec(Id, 0, 0, 0, 1, 0, 1, 0, BufFree, 0, 0, 0, 0)
END;

COMMENT BLOCK 049;
COMMENT Component: AwgZeroKernel;
COMMENT Purpose: AwgZeroKernel as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
