COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgNameSet(INTEGER VALUE Id; STRING(48) VALUE S;
                     INTEGER RESULT Status);
BEGIN
    IF (Id < 0) OR (Id > 63) THEN
    BEGIN
        Status := StBounds;
        AwgSetStatus(StBounds, 32, Id)
    END
    ELSE
    BEGIN
        AwgName(Id) := S;
        Status := StOk
    END
END;

