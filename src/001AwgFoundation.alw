COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgLogPush(STRING(80) VALUE Line; INTEGER RESULT Status);
BEGIN
    IF AwgLogCount >= 64 THEN Status := StFull
    ELSE
    BEGIN
        AwgLog(AwgLogCount) := Line;
        AwgLogCount := AwgLogCount + 1;
        Status := StOk
    END
END;

