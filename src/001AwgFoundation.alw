COMMENT BLOCK 028 invariant checking;
COMMENT BLOCK 028;
COMMENT Component: AwgInvariantCheck;
COMMENT Purpose: AwgInvariantCheck as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgInvariantCheck;
COMMENT Parent-ID: AWG-FILE-001AwgFoundation;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgInvariantCheck(INTEGER RESULT Status);
BEGIN
    INTEGER N, Bad;
    Bad := 0;
    AwgStateValidate(Status);
    IF Status # StOk THEN Bad := 1;
    IF AwgConfig = NULL THEN Bad := 1;
    IF AwgCaps = NULL THEN Bad := 1;
    IF AwgBackend = NULL THEN Bad := 1;
    IF TileM <= 0 THEN Bad := 1;
    IF TileN <= 0 THEN Bad := 1;
    IF TileK <= 0 THEN Bad := 1;
    FOR N := 0 STEP 1 UNTIL 31 DO
        IF (AwgLaneAct(N) # 0) AND (AwgLaneAct(N) # 1) THEN Bad := 1;
    IF Bad = 1 THEN
    BEGIN
        Status := StValidate;
        AwgSetStatus(StValidate, 28, 0)
    END
    ELSE Status := StOk
END;

