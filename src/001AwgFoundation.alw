    AwgOwnerToken := 0
END;

COMMENT SOVEREIGN NODE KEY: AWG-FILE-001AwgFoundation-BLK-027-60;
COMMENT Parent-ID: AWG-FILE-001AwgFoundation;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
