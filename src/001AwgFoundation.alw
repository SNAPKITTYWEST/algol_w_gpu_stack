COMMENT BLOCK 029-031 handle allocator;
COMMENT BLOCK 029-031;
COMMENT Component: AwgHandleAlloc;
COMMENT Purpose: AwgHandleAlloc as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgHandleAlloc;
COMMENT Parent-ID: AWG-FILE-001AwgFoundation;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
INTEGER PROCEDURE AwgHandleAlloc(INTEGER VALUE RESULT Next;
                                 INTEGER VALUE Cap;
                                 INTEGER RESULT Status);
BEGIN
    IF Next >= Cap THEN
    BEGIN
        Status := StOom;
        AwgSetStatus(StOom, 29, Next);
        AwgHandleAlloc := -1
    END
    ELSE
    BEGIN
        AwgHandleAlloc := Next;
        Next := Next + 1;
        Status := StOk
    END
END;

COMMENT BLOCK 029-031;
COMMENT Component: AwgHandleValidate;
COMMENT Purpose: AwgHandleValidate as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgHandleValidate;
COMMENT Parent-ID: AWG-FILE-001AwgFoundation;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgHandleValidate(INTEGER VALUE Id, Cap; INTEGER RESULT Status);
BEGIN
    IF (Id < 0) OR (Id >= Cap) THEN
    BEGIN
        Status := StInvalid;
        AwgSetStatus(StInvalid, 31, Id)
    END
    ELSE Status := StOk
END;

