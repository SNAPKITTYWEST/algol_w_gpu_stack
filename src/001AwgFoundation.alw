COMMENT BLOCK 026 runtime shutdown;
COMMENT BLOCK 026;
COMMENT Component: AwgRuntimeShutdown;
COMMENT Purpose: AwgRuntimeShutdown as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgRuntimeShutdown;
COMMENT Parent-ID: AWG-FILE-001AwgFoundation;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgRuntimeShutdown(INTEGER RESULT Status);
BEGIN
    INTEGER N;
    IF AwgInitialized # 1 THEN
    BEGIN
        Status := StNotInit;
        AwgSetStatus(StNotInit, 26, 0)
    END
    ELSE
    BEGIN
        FOR N := 0 STEP 1 UNTIL 63 DO
        BEGIN
            IF AwgBufTab(N) # NULL THEN AwgBufTab(N).State := BufReleased
        END;
        AwgInitialized := 0;
        AwgDropOwner;
        IF AwgCtx # NULL THEN AwgCtx.Life := LifeShutdown;
        Status := StOk;
        AwgSetStatus(StOk, 26, 0)
    END
END;

COMMENT SOVEREIGN NODE KEY: AWG-FILE-001AwgFoundation-BLK-050-77;
COMMENT Parent-ID: AWG-FILE-001AwgFoundation;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
