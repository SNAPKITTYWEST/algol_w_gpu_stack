COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgZeroKernel(INTEGER VALUE Id);
BEGIN
    IF (Id >= 0) AND (Id <= 31) THEN
    BEGIN
        AwgKTab(Id) := AwgKMetaRec(Id, 0, 0, 0, 0, 0, 0, 0, 0, " ");
        AwgKStart(Id) := 0;
        AwgKLen(Id) := 0;
        AwgKValid(Id) := 0
    END
END;

