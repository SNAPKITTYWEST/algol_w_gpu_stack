COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
INTEGER PROCEDURE AwgINot31(INTEGER VALUE A);
BEGIN
    COMMENT 31-bit ones complement in the portable model;
    AwgINot31 := AwgIXor(A, 2147483647)
END;

COMMENT BLOCK 046;
COMMENT Component: AwgIShl;
COMMENT Purpose: AwgIShl as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgIShl;
COMMENT Parent-ID: AWG-FILE-001AwgFoundation;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
INTEGER PROCEDURE AwgIShl(INTEGER VALUE A, N);
BEGIN
    INTEGER R, I;
    R := A;
    IF N <= 0 THEN AwgIShl := A
    ELSE IF N >= 31 THEN AwgIShl := 0
    ELSE
    BEGIN
        FOR I := 1 STEP 1 UNTIL N DO
        BEGIN
            IF R > (MaxInt DIV 2) THEN R := 0
            ELSE R := R * 2
        END;
        AwgIShl := R
    END
END;

COMMENT BLOCK 046;
COMMENT Component: AwgIShr;
COMMENT Purpose: AwgIShr as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgIShr;
COMMENT Parent-ID: AWG-FILE-001AwgFoundation;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
INTEGER PROCEDURE AwgIShr(INTEGER VALUE A, N);
BEGIN
    INTEGER R, I;
    R := A;
    IF N <= 0 THEN AwgIShr := A
    ELSE IF N >= 31 THEN AwgIShr := 0
    ELSE
    BEGIN
        FOR I := 1 STEP 1 UNTIL N DO R := R DIV 2;
        AwgIShr := R
    END
END;

COMMENT BLOCK 046;
COMMENT Component: AwgPackBits;
COMMENT Purpose: AwgPackBits as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgPackBits;
COMMENT Parent-ID: AWG-FILE-001AwgFoundation;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
INTEGER PROCEDURE AwgPackBits(INTEGER VALUE Field, Width, Shift, Base);
BEGIN
    INTEGER M, F;
    M := AwgIShl(1, Width) - 1;
    F := AwgIAnd(Field, M);
    AwgPackBits := AwgIOr(Base, AwgIShl(F, Shift))
END;

COMMENT BLOCK 046;
COMMENT Component: AwgUnpackBits;
COMMENT Purpose: AwgUnpackBits as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgUnpackBits;
COMMENT Parent-ID: AWG-FILE-001AwgFoundation;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
INTEGER PROCEDURE AwgUnpackBits(INTEGER VALUE Word, Width, Shift);
BEGIN
    INTEGER M;
    M := AwgIShl(1, Width) - 1;
    AwgUnpackBits := AwgIAnd(AwgIShr(Word, Shift), M)
END;

