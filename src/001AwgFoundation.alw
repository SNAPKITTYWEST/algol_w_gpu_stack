COMMENT Provenance: docs/NODE_MANIFEST.json;
INTEGER PROCEDURE AwgIXor(INTEGER VALUE A, B);
BEGIN
    INTEGER R, P, X, Y;
    R := 0; P := 1;
    X := A; Y := B;
    IF X < 0 THEN X := 0;
    IF Y < 0 THEN Y := 0;
    WHILE (X > 0) OR (Y > 0) DO
    BEGIN
        IF ODD(X) # ODD(Y) THEN R := R + P;
        X := X DIV 2;
        Y := Y DIV 2;
        IF P > (MaxInt DIV 2) THEN
        BEGIN
            X := 0; Y := 0
        END
        ELSE P := P * 2
    END;
    AwgIXor := R
END;

COMMENT BLOCK 046;
COMMENT Component: AwgINot31;
COMMENT Purpose: AwgINot31 as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
