COMMENT BLOCK 047;
COMMENT Component: AwgPopc;
COMMENT Purpose: AwgPopc as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgPopc;
COMMENT Parent-ID: AWG-FILE-001AwgFoundation;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
INTEGER PROCEDURE AwgPopc(INTEGER VALUE A);
BEGIN
    INTEGER N, X;
    N := 0; X := A;
    IF X < 0 THEN X := 0;
    WHILE X > 0 DO
    BEGIN
        IF ODD(X) THEN N := N + 1;
        X := X DIV 2
    END;
    AwgPopc := N
END;

COMMENT BLOCK 047;
COMMENT Component: AwgClz;
COMMENT Purpose: AwgClz as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgClz;
COMMENT Parent-ID: AWG-FILE-001AwgFoundation;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
INTEGER PROCEDURE AwgClz(INTEGER VALUE A);
BEGIN
    INTEGER N, X, P;
    IF A <= 0 THEN AwgClz := 31
    ELSE
    BEGIN
        N := 0; X := A; P := AwgIShl(1, 30);
        WHILE (P > 0) AND (AwgIAnd(X, P) = 0) DO
        BEGIN
            N := N + 1;
            P := P DIV 2
        END;
        AwgClz := N
    END
END;

COMMENT BLOCK 047;
COMMENT Component: AwgBrev;
COMMENT Purpose: AwgBrev as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgBrev;
COMMENT Parent-ID: AWG-FILE-001AwgFoundation;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
INTEGER PROCEDURE AwgBrev(INTEGER VALUE A);
BEGIN
    INTEGER R, X, I;
    R := 0; X := A;
    IF X < 0 THEN X := 0;
    FOR I := 0 STEP 1 UNTIL 30 DO
    BEGIN
        R := R * 2;
        IF ODD(X) THEN R := R + 1;
        X := X DIV 2
    END;
    AwgBrev := R
END;

