COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgFillCaps;
BEGIN
    COMMENT GpuExec, HwSync, HwSimd, HwOccupancy remain 0 until a;
    COMMENT real hardware backend is bound. RefExec and CpuExec are 1;
    COMMENT because the reference interpreter runs in ALGOL W.;
    AwgCaps := AwgCapRec(1, 1, 0, 1, 1, 1, 1, 0, 0, 0)
END;

