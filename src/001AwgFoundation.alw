INTEGER PROCEDURE AwgIOr(INTEGER VALUE A, B);
BEGIN
    INTEGER R, P, X, Y;
    R := 0; P := 1;
    X := A; Y := B;
    IF X < 0 THEN X := 0;
    IF Y < 0 THEN Y := 0;
    WHILE (X > 0) OR (Y > 0) DO
    BEGIN
        IF ODD(X) OR ODD(Y) THEN R := R + P;
        X := X DIV 2;
        Y := Y DIV 2;
        IF P > (MaxInt DIV 2) THEN
        BEGIN
            X := 0; Y := 0
        END
        ELSE P := P * 2
    END;
    AwgIOr := R
END;

COMMENT BLOCK 046;
COMMENT Component: AwgIXor;
COMMENT Purpose: AwgIXor as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
