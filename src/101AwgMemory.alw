COMMENT BLOCK 133-134 views and sub-buffers;
COMMENT BLOCK 133-134;
COMMENT Component: AwgView;
COMMENT Purpose: AwgView as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgView;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgView(INTEGER VALUE Bid, Off, Len; INTEGER RESULT VBid, Status);
BEGIN
    INTEGER Space, Kind, Base;
    VBid := -1;
    AwgOwnershipCheck(Bid, Status);
    IF Status = StOk THEN
    BEGIN
        IF (Off < 0) OR (Len < 0) OR (Off + Len > AwgBufTab(Bid).Length) THEN
            Status := StBounds
        ELSE
        BEGIN
            Space := AwgBufTab(Bid).Space;
            Kind := AwgBufTab(Bid).ElemKind;
            Base := AwgBufTab(Bid).Offset + Off;
            AwgBufAlloc(Space, 0, Kind, 1, VBid, Status);
            COMMENT length-0 alloc then overwrite descriptor to view;
            IF Status = StOk THEN
            BEGIN
                AwgBufTab(VBid).Offset := Base;
                AwgBufTab(VBid).Length := Len;
                AwgBufTab(VBid).Space := Space;
                AwgBufTab(VBid).ElemKind := Kind;
                AwgBufTab(VBid).State := BufAlloc
            END
        END
    END
END;

