COMMENT BLOCK 125 memory validation;
COMMENT BLOCK 125;
COMMENT Component: AwgMemValidate;
COMMENT Purpose: AwgMemValidate as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgMemValidate;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgMemValidate(INTEGER RESULT Status);
BEGIN
    INTEGER N, Bad;
    Bad := 0;
    IF AwgHostUsed > CapHost THEN Bad := 1;
    IF AwgDevUsed > CapDev THEN Bad := 1;
    IF AwgSharedUsed > CapShared THEN Bad := 1;
    FOR N := 0 STEP 1 UNTIL AwgNextBuf - 1 DO
    BEGIN
        IF AwgBufTab(N) # NULL THEN
        BEGIN
            IF AwgBufTab(N).Offset < 0 THEN Bad := 1;
            IF AwgBufTab(N).Length < 0 THEN Bad := 1
        END
    END;
    IF Bad = 1 THEN
    BEGIN Status := StValidate; AwgSetStatus(StValidate, 125, 0) END
    ELSE Status := StOk
END;

COMMENT SOVEREIGN NODE KEY: AWG-FILE-101AwgMemory-BLK-130-53;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
