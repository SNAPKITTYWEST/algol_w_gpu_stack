COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
COMMENT BLOCK 109 descriptor fill;
COMMENT BLOCK 109;
COMMENT Component: AwgBufDescFill;
COMMENT Purpose: AwgBufDescFill as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgBufDescFill;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgBufDescFill(INTEGER VALUE Bid, Space, Off, Len, Stride, Kind;
                         INTEGER RESULT Status);
BEGIN
    AwgHandleValidate(Bid, CapBufs, Status);
    IF Status = StOk THEN
    BEGIN
        AwgBoundsCheck(Space, Off, Len, Status);
        IF Status = StOk THEN
            AwgBufTab(Bid) := AwgBufRec(Bid, Space, Off, Len, Stride, Kind,
                                        1, AwgOwnerToken, BufAlloc, Len, Len, 1, 1)
    END
END;

COMMENT SOVEREIGN NODE KEY: AWG-FILE-101AwgMemory-BLK-126-127-33;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
