COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgPinHost(INTEGER VALUE Bid; INTEGER RESULT Status);
BEGIN
    COMMENT Page-locked host memory requires OS/GPU driver support.;
    AwgOwnershipCheck(Bid, Status);
    IF Status = StOk THEN
    BEGIN
        Status := StHwDep;
        AwgSetStatus(StHwDep, 130, Bid)
    END
END;

COMMENT SOVEREIGN NODE KEY: AWG-FILE-101AwgMemory-BLK-131-132-55;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
COMMENT BLOCK 131-132 map/unmap — software view only;
COMMENT BLOCK 131-132;
COMMENT Component: AwgMapBuffer;
COMMENT Purpose: AwgMapBuffer as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgMapBuffer;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgMapBuffer(INTEGER VALUE Bid; INTEGER RESULT Off, Status);
BEGIN
    AwgOwnershipCheck(Bid, Status);
    IF Status = StOk THEN
    BEGIN
        AwgBufTab(Bid).State := BufMapped;
        Off := AwgBufTab(Bid).Offset;
        COMMENT Mapping device memory into a host pointer is hardware.;
        IF AwgBufTab(Bid).Space = MemDevice THEN
            COMMENT software still returns the DevR offset; not a GPU map;
            Off := Off
    END
    ELSE Off := -1
END;

COMMENT BLOCK 131-132;
COMMENT Component: AwgUnmapBuffer;
COMMENT Purpose: AwgUnmapBuffer as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgUnmapBuffer;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgUnmapBuffer(INTEGER VALUE Bid; INTEGER RESULT Status);
BEGIN
    AwgOwnershipCheck(Bid, Status);
    IF Status = StOk THEN AwgBufTab(Bid).State := BufAlloc
END;

COMMENT SOVEREIGN NODE KEY: AWG-FILE-101AwgMemory-BLK-133-134-58;
