INTEGER PROCEDURE AwgRegReadI(INTEGER VALUE R; INTEGER RESULT Status);
BEGIN
    IF (R < 0) OR (R >= CapIreg) THEN
    BEGIN Status := StBounds; AwgRegReadI := 0 END
    ELSE BEGIN Status := StOk; AwgRegReadI := AwgIReg(R) END
END;

