COMMENT BLOCK 119 memory copy between spaces;
COMMENT BLOCK 119;
COMMENT Component: AwgMemCopy;
COMMENT Purpose: AwgMemCopy as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgMemCopy;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgMemCopy(INTEGER VALUE SrcSpace, SrcOff, DstSpace, DstOff, Len;
                     INTEGER RESULT Status);
BEGIN
    INTEGER N;
    REAL V;
    INTEGER IV;
    AwgBoundsCheck(SrcSpace, SrcOff, Len, Status);
    IF Status = StOk THEN AwgBoundsCheck(DstSpace, DstOff, Len, Status);
    IF Status # StOk THEN
        Status := Status
    ELSE IF (SrcSpace = DstSpace) AND AwgRangesAlias(SrcOff, Len, DstOff, Len) THEN
    BEGIN
        Status := StAlias;
        AwgSetStatus(StAlias, 119, SrcOff)
    END
    ELSE
    BEGIN
        FOR N := 0 STEP 1 UNTIL Len - 1 DO
        BEGIN
            V := AwgRLoad(SrcSpace, SrcOff + N, Status);
            IF Status # StOk THEN N := Len
            ELSE AwgRStore(DstSpace, DstOff + N, V, Status)
        END
    END
END;

COMMENT integer copy for index buffers;
COMMENT BLOCK 119;
COMMENT Component: AwgMemCopyI;
COMMENT Purpose: AwgMemCopyI as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgMemCopyI;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgMemCopyI(INTEGER VALUE SrcSpace, SrcOff, DstSpace, DstOff, Len;
                      INTEGER RESULT Status);
BEGIN
    INTEGER N, V;
    AwgBoundsCheck(SrcSpace, SrcOff, Len, Status);
    IF Status = StOk THEN AwgBoundsCheck(DstSpace, DstOff, Len, Status);
    IF Status = StOk THEN
    BEGIN
        IF (SrcSpace # MemHost) AND (SrcSpace # MemDevice) THEN Status := StInvalid
        ELSE IF (DstSpace # MemHost) AND (DstSpace # MemDevice) THEN Status := StInvalid
        ELSE
        FOR N := 0 STEP 1 UNTIL Len - 1 DO
        BEGIN
            V := AwgILoad(SrcSpace, SrcOff + N, Status);
            IF Status = StOk THEN AwgIStore(DstSpace, DstOff + N, V, Status)
        END
    END
END;

