COMMENT BLOCK 144-145 shared-memory bank model (software estimate);
COMMENT BLOCK 144-145;
COMMENT Component: AwgSharedBank;
COMMENT Purpose: AwgSharedBank as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgSharedBank;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
INTEGER PROCEDURE AwgSharedBank(INTEGER VALUE Addr, Nbanks);
BEGIN
    INTEGER B;
    B := Nbanks;
    IF B <= 0 THEN B := 32;
    AwgSharedBank := Addr REM B
END;

COMMENT BLOCK 144-145;
COMMENT Component: AwgBankConflictModel;
COMMENT Purpose: AwgBankConflictModel as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgBankConflictModel;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
INTEGER PROCEDURE AwgBankConflictModel(INTEGER VALUE N, Stride, Nbanks);
BEGIN
    COMMENT Estimate: if stride and nbanks are not coprime, conflicts.;
    INTEGER B, S, Conflicts;
    B := Nbanks; IF B <= 0 THEN B := 32;
    S := Stride REM B;
    IF S = 0 THEN Conflicts := N
    ELSE Conflicts := 1;
    AwgBankConflictModel := Conflicts
END;

