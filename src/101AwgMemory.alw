COMMENT BLOCK 137-138 pitched copies;
COMMENT BLOCK 137-138;
COMMENT Component: AwgCopy2D;
COMMENT Purpose: AwgCopy2D as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgCopy2D;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgCopy2D(INTEGER VALUE SrcSpace, SrcOff, SrcPitch,
                           DstSpace, DstOff, DstPitch,
                           Width, Height; INTEGER RESULT Status);
BEGIN
    INTEGER R;
    Status := StOk;
    FOR R := 0 STEP 1 UNTIL Height - 1 DO
    BEGIN
        AwgMemCopy(SrcSpace, SrcOff + R * SrcPitch,
                   DstSpace, DstOff + R * DstPitch, Width, Status);
        IF Status # StOk THEN R := Height
    END
END;

COMMENT BLOCK 137-138;
COMMENT Component: AwgCopy3D;
COMMENT Purpose: AwgCopy3D as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgCopy3D;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgCopy3D(INTEGER VALUE SrcSpace, SrcOff, SrcP, SrcD,
                           DstSpace, DstOff, DstP, DstD,
                           Width, Height, Depth; INTEGER RESULT Status);
BEGIN
    INTEGER Z;
    Status := StOk;
    FOR Z := 0 STEP 1 UNTIL Depth - 1 DO
    BEGIN
        AwgCopy2D(SrcSpace, SrcOff + Z * SrcD, SrcP,
                  DstSpace, DstOff + Z * DstD, DstP,
                  Width, Height, Status);
        IF Status # StOk THEN Z := Depth
    END
END;

