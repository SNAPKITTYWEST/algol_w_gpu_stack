INTEGER PROCEDURE AwgSpaceUsed(INTEGER VALUE Space);
BEGIN
    IF Space = MemHost THEN AwgSpaceUsed := AwgHostUsed
    ELSE IF Space = MemDevice THEN AwgSpaceUsed := AwgDevUsed
    ELSE IF Space = MemShared THEN AwgSpaceUsed := AwgSharedUsed
    ELSE IF Space = MemLocal THEN AwgSpaceUsed := AwgLocalUsed
    ELSE IF Space = MemConstant THEN AwgSpaceUsed := AwgConstUsed
    ELSE AwgSpaceUsed := 0
END;

COMMENT BLOCK 101-150;
COMMENT Component: AwgSpaceAddUsed;
COMMENT Purpose: AwgSpaceAddUsed as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgSpaceAddUsed;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgSpaceAddUsed(INTEGER VALUE Space, N);
BEGIN
    IF Space = MemHost THEN AwgHostUsed := AwgHostUsed + N
    ELSE IF Space = MemDevice THEN AwgDevUsed := AwgDevUsed + N
    ELSE IF Space = MemShared THEN AwgSharedUsed := AwgSharedUsed + N
    ELSE IF Space = MemLocal THEN AwgLocalUsed := AwgLocalUsed + N
    ELSE IF Space = MemConstant THEN AwgConstUsed := AwgConstUsed + N
END;

