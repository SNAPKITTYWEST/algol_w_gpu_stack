    IF Status = StOk THEN
        FOR N := 0 STEP 1 UNTIL Len - 1 DO
            AwgIStore(Space, Off + N, V, Status)
END;

COMMENT SOVEREIGN NODE KEY: AWG-FILE-101AwgMemory-BLK-125-51;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
