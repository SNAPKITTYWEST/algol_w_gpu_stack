COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgBufAlloc;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgBufAlloc(INTEGER VALUE Space, Length, Kind, Align;
                      INTEGER RESULT Bid, Status);
BEGIN
    INTEGER Off, Cap, Used, A, Id;
    Bid := -1;
    IF AwgInitialized # 1 THEN
    BEGIN Status := StNotInit; AwgSetStatus(StNotInit, 107, 0) END
    ELSE IF Length < 0 THEN
    BEGIN Status := StInvalid; AwgSetStatus(StInvalid, 107, Length) END
    ELSE
    BEGIN
        A := Align;
        IF A <= 0 THEN A := 1;
        Cap := AwgSpaceCap(Space);
        Used := AwgSpaceUsed(Space);
        Off := AwgAlignUp(Used, A);
        IF Off + Length > Cap THEN
        BEGIN
            Status := StOom;
            AwgSetStatus(StOom, 107, Length)
        END
        ELSE
        BEGIN
            Id := AwgHandleAlloc(AwgNextBuf, CapBufs, Status);
            IF Status = StOk THEN
            BEGIN
                AwgBufTab(Id) := AwgBufRec(Id, Space, Off, Length, 1, Kind, A,
                                          AwgOwnerToken, BufAlloc, Length, Length, 1, 1);
                AwgBufOwner(Id) := AwgOwnerToken;
                AwgBufLife(Id) := 1;
                AwgBufSpace(Id) := Space;
                AwgSpaceAddUsed(Space, (Off + Length) - Used);
                AwgSpaceBytes(Space) := AwgSpaceBytes(Space) + Length;
                Bid := Id;
                Status := StOk
            END
        END
    END
END;

COMMENT SOVEREIGN NODE KEY: AWG-FILE-101AwgMemory-BLK-108-29;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
COMMENT BLOCK 108 release;
COMMENT BLOCK 108;
COMMENT Component: AwgBufRelease;
COMMENT Purpose: AwgBufRelease as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgBufRelease;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgBufRelease(INTEGER VALUE Bid; INTEGER RESULT Status);
BEGIN
    AwgHandleValidate(Bid, CapBufs, Status);
    IF Status # StOk THEN
        Status := Status
    ELSE IF AwgBufTab(Bid) = NULL THEN Status := StNullRef
    ELSE IF AwgBufTab(Bid).State = BufReleased THEN Status := StLifetime
    ELSE
    BEGIN
        AwgBufTab(Bid).State := BufReleased;
        AwgBufLife(Bid) := 0;
        Status := StOk
    END
END;

COMMENT SOVEREIGN NODE KEY: AWG-FILE-101AwgMemory-BLK-109-31;
COMMENT Parent-ID: AWG-FILE-101AwgMemory;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
