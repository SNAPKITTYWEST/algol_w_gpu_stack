COMMENT BLOCK 023;
COMMENT Component: AwgSetStatus;
COMMENT Purpose: record last status and error payload;
COMMENT Inputs: Code, BlockNo, Info;
COMMENT Outputs: AwgLastStatus, AwgErr*;
COMMENT Dependencies: error globals;
COMMENT Hardware: none;
COMMENT BLOCK 023;
COMMENT Component: AwgSetStatus;
COMMENT Purpose: AwgSetStatus as defined by the following supplied procedure;
COMMENT Inputs: VALUE parameters and referenced global state;
COMMENT Outputs: function result, RESULT parameters and stated global mutations;
COMMENT Dependencies: AwgHead declarations and referenced Awg helpers;
COMMENT Hardware: none (reference software or explicit unavailable status);
COMMENT SOVEREIGN NODE KEY: AWG-PROC-AwgSetStatus;
COMMENT Parent-ID: AWG-FILE-000AwgConstants;
COMMENT License-ID: SL-AGPL3-001 / MGPLv3;
COMMENT Covenant-Version: 1.0;
COMMENT Copyright: 2026 SNAPKITTYWEST;
COMMENT License-Location: LICENSE;
COMMENT Provenance: docs/NODE_MANIFEST.json;
PROCEDURE AwgSetStatus(INTEGER VALUE Code, BlockNo, Info);
BEGIN
    AwgLastStatus := Code;
    AwgErrCode := Code;
    AwgErrBlock := BlockNo;
    AwgErrInfo := Info;
    IF AwgLastErr # NULL THEN
    BEGIN
        AwgLastErr.Code := Code;
        AwgLastErr.BlockNo := BlockNo;
        AwgLastErr.Info := Info
    END
END;

